{
  "name": "atelie-afro-cultural",
  "private": true,
  "description": "Site do Ateliê Afro Cultural — Next.js 16, sem bundler extra. `next build` é obrigatório antes de servir; selenium-webdriver roda as verificações de navegador.",
  "scripts": {
    "test": "node ferramentas/rodar-testes.mjs",
    "test:supabase": "COM_SUPABASE=1 node ferramentas/rodar-testes.mjs",
    "test:supabase-degradado": "COM_SUPABASE=chave-errada node ferramentas/rodar-testes.mjs testes/origem-dos-dados.test.mjs testes/degradacao.test.mjs",
    "verificar": "node ferramentas/rodar-testes.mjs testes/navegador.test.mjs",
    "verificar-deploy": "node ferramentas/verificar-antes-do-deploy.mjs",
    "seed": "node ferramentas/gerar-seed.mjs",
    "rls": "node --test testes/rls.test.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "selenium-webdriver": "^4.27.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "typescript": "7.0.2"
  }
}
